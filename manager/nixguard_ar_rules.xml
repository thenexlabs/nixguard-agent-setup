<!--
  NixGuard active response results. Install on every Wazuh MANAGER whose endpoints NixGuard blocks on, not on endpoints.

  The endpoint scripts (nixguard-remediate, nixguard-unblock-ip) write one result line per IP block or unblock to the
  agent's active-responses.log, which every Wazuh agent already forwards:

    2026/11/12 10:00:00 active-response/bin/nixguard-remediate: {"version":1,"command":"add","parameters":{"program":"nixguard-remediate"},"nixguard":{"action":"block-ip","target":"203.0.113.7","run":"ngr-...","result":"success","reason":"blocked"}}

  Wazuh's built-in decoder ar_log_json reads that line and the built-in rule 657 ("Active response:
  $(parameters.program) - $(command)") matches it, but only at level 3. A manager stores only alerts at or above its
  log_alert_level (Wazuh's default is 3; NixGuard-provisioned managers and many hardened ones use 4), so at level 3 the
  result is often never stored and NixGuard cannot confirm the run. These child rules of 657 raise results to level 5
  (success) and 7 (failure), above both thresholds, and give them clear descriptions. NixGuard reads data.nixguard.*
  whichever rule fired. The group active_response keeps them out of NixGuard's "act on new alerts".

  Install (as root on the manager):
    cp nixguard_ar_rules.xml /var/ossec/etc/rules/nixguard_ar_rules.xml
    chown wazuh:wazuh /var/ossec/etc/rules/nixguard_ar_rules.xml && chmod 660 /var/ossec/etc/rules/nixguard_ar_rules.xml
    /var/ossec/bin/wazuh-analysisd -t        # must print no error
    systemctl restart wazuh-manager
  Check: /var/ossec/bin/wazuh-logtest, paste the example line above, expect rule id 100910, level 5, and
  "Alert to be generated".
  IDs 100910-100917 must not be used by another custom rule on that manager. A manager whose log_alert_level is above
  5 still drops the success results: raise these levels to match it rather than lowering the threshold.
-->
<group name="nixguard,active_response,">

  <rule id="100910" level="5">
    <if_sid>657</if_sid>
    <field name="nixguard.action">^block-ip$</field>
    <field name="nixguard.result">^success$</field>
    <description>NixGuard: blocked $(nixguard.target) on the endpoint ($(nixguard.reason))</description>
  </rule>

  <rule id="100911" level="7">
    <if_sid>657</if_sid>
    <field name="nixguard.action">^block-ip$</field>
    <field name="nixguard.result">^failure$</field>
    <description>NixGuard: could not block $(nixguard.target) on the endpoint ($(nixguard.reason))</description>
  </rule>

  <rule id="100912" level="5">
    <if_sid>657</if_sid>
    <field name="nixguard.action">^unblock-ip$</field>
    <field name="nixguard.result">^success$</field>
    <description>NixGuard: unblocked $(nixguard.target) on the endpoint ($(nixguard.reason))</description>
  </rule>

  <rule id="100913" level="7">
    <if_sid>657</if_sid>
    <field name="nixguard.action">^unblock-ip$</field>
    <field name="nixguard.result">^failure$</field>
    <description>NixGuard: could not unblock $(nixguard.target) on the endpoint ($(nixguard.reason))</description>
  </rule>

  <!-- Endpoint hardening (nixguard-harden): target is the fix id, e.g. sshd-limits. -->
  <rule id="100914" level="5">
    <if_sid>657</if_sid>
    <field name="nixguard.action">^harden$</field>
    <field name="nixguard.result">^success$</field>
    <description>NixGuard: applied hardening fix $(nixguard.target) on the endpoint ($(nixguard.reason))</description>
  </rule>

  <rule id="100915" level="7">
    <if_sid>657</if_sid>
    <field name="nixguard.action">^harden$</field>
    <field name="nixguard.result">^failure$</field>
    <description>NixGuard: could not apply hardening fix $(nixguard.target) on the endpoint ($(nixguard.reason))</description>
  </rule>

  <rule id="100916" level="5">
    <if_sid>657</if_sid>
    <field name="nixguard.action">^unharden$</field>
    <field name="nixguard.result">^success$</field>
    <description>NixGuard: undid hardening fix $(nixguard.target) on the endpoint ($(nixguard.reason))</description>
  </rule>

  <rule id="100917" level="7">
    <if_sid>657</if_sid>
    <field name="nixguard.action">^unharden$</field>
    <field name="nixguard.result">^failure$</field>
    <description>NixGuard: could not undo hardening fix $(nixguard.target) on the endpoint ($(nixguard.reason))</description>
  </rule>

</group>
